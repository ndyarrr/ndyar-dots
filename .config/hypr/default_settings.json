{
  "uiScale": 1.0,
  "openGuideAtStartup": false,
  "topbarHelpIcon": true,
  "workspaceCount": 8,
  "topbarPosition": "top",
  "networkUiMode": "current",
  "wifiUiMode": "current",
  "btUiMode": "current",
  "wallpaperDir": "",
  "language": "us",
  "kbOptions": "grp:alt_shift_toggle",
  "monitors": [],
  "keybinds": [
    {
      "type": "bind",
      "mods": "ALT",
      "key": "F4",
      "dispatcher": "exec",
      "command": "hyprctl dispatch 'hl.dsp.window.close()'"
    },
    {
      "type": "bind",
      "mods": "SUPER SHIFT",
      "key": "F",
      "dispatcher": "exec",
      "command": "hyprctl dispatch 'hl.dsp.window.float({ action = \"toggle\" })'"
    },
    {
      "type": "binde",
      "mods": "SUPER SHIFT",
      "key": "left",
      "dispatcher": "resizeactive",
      "command": "-50 0"
    },
    {
      "type": "binde",
      "mods": "SUPER SHIFT",
      "key": "right",
      "dispatcher": "resizeactive",
      "command": "50 0"
    },
    {
      "type": "binde",
      "mods": "SUPER SHIFT",
      "key": "up",
      "dispatcher": "resizeactive",
      "command": "0 -50"
    },
    {
      "type": "binde",
      "mods": "SUPER SHIFT",
      "key": "down",
      "dispatcher": "resizeactive",
      "command": "0 50"
    },
    {
      "type": "bind",
      "mods": "SUPER CTRL",
      "key": "left",
      "dispatcher": "movewindow",
      "command": "l"
    },
    {
      "type": "bind",
      "mods": "SUPER CTRL",
      "key": "right",
      "dispatcher": "movewindow",
      "command": "r"
    },
    {
      "type": "bind",
      "mods": "SUPER CTRL",
      "key": "up",
      "dispatcher": "movewindow",
      "command": "u"
    },
    {
      "type": "bind",
      "mods": "SUPER CTRL",
      "key": "down",
      "dispatcher": "movewindow",
      "command": "d"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "left",
      "dispatcher": "movefocus",
      "command": "l"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "right",
      "dispatcher": "movefocus",
      "command": "r"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "up",
      "dispatcher": "movefocus",
      "command": "u"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "T",
      "dispatcher": "exec",
      "command": "python3 ~/.config/hypr/scripts/infinite_desktop/floating_tile_toggle.py"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "RETURN",
      "dispatcher": "exec",
      "command": "foot"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "F",
      "dispatcher": "exec",
      "command": "firefox"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "E",
      "dispatcher": "exec",
      "command": "nautilus"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "R",
      "dispatcher": "exec",
      "command": "bash ~/.config/hypr/scripts/reload.sh"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "C",
      "dispatcher": "exec",
      "command": "~/.config/hypr/scripts/qs_manager.sh toggle clipboard"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "P",
      "dispatcher": "exec",
      "command": "~/.config/hypr/scripts/qs_manager.sh toggle movies"
    },
    {
      "type": "bind",
      "mods": "SUPER",
