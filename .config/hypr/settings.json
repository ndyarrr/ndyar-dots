  "startup": [
    {
      "command": "hyprpolkitagent &"
    },
    {
      "command": "awww-daemon &"
    },
    {
      "command": "hypridle &"
    },
    {
      "command": "bash -c 'quickshell -p $HOME/.config/hypr/scripts/quickshell/Shell.qml' &"
    },
    {
      "command": "bash ~/.config/hypr/scripts/quickshell/focustime/launch_daemon.sh &"
    },
    {
      "command": "bash ~/.config/hypr/scripts/init.sh &"
    },
    {
      "command": "bash ~/.config/hypr/scripts/settings_watcher.sh &"
    },
    {
      "command": "playerctld &"
    },
    {
      "command": "swayosd-server --top-margin 0.9 --style \"$HOME/.config/swayosd/style.css\" &"
    },
    {
      "command": "wl-paste --type text --watch cliphist store &"
    },
    {
      "command": "wl-paste --type image --watch cliphist store &"
    },
    {
      "command": "bash ~/.config/hypr/scripts/volume_listener.sh &"
    },
    {
      "command": "bash ~/.config/hypr/scripts/update_notifier.sh &"
    },
    {
      "command": "bash ~/.config/hypr/scripts/brightness.sh restore &"
    },
    {
      "command": "bash -c 'pkill -f infinite_desktop_core.py; python3 $HOME/.config/hypr/scripts/infinite_desktop/infinite_desktop_core.py 1.6' &"
    }
  ]
